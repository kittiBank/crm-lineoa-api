# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (local docker-compose)
DATABASE_URL=postgresql://user:password@localhost:5432/crm_lineoa_db

# Database Sandbox (AWS RDS) — uncomment & fill when running migrate against RDS
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d

# LINE BOT
LINE_BOT_CHANNEL_ACCESS_TOKEN=your_line_bot_token_here
LINE_BOT_CHANNEL_SECRET=your_line_bot_secret_here

# Member login OTP (demo)
OTP_CODE=123456
OTP_TTL_SECONDS=60

# Frontend / LIFF origins (CORS)
# FRONTEND_URL=https://your-frontend.example.com
# LIFF_ENDPOINT_URL=https://your-liff-endpoint.example.com/liff/login

# AMQP (RabbitMQ)
AMQP_URL=amqp://guest:guest@localhost:5672

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=crm-lineoa
MINIO_PUBLIC_URL=http://localhost:9000

# Logging
LOG_LEVEL=debug

# ── EC2 / docker-compose.prod.yml ───────────────────────────────────────────
# Copy this file to .env on the server and adjust:
#
# NODE_ENV=production
# LOG_LEVEL=info
# DATABASE_URL=postgresql://USER:PASSWORD@RDS_HOST:5432/DBNAME?sslmode=require
#
# RabbitMQ (internal compose network — must match RABBITMQ_* below)
# AMQP_URL=amqp://crm:changeme@rabbitmq:5672
# RABBITMQ_USER=crm
# RABBITMQ_PASS=changeme
#
# MinIO (service hostname inside compose)
# MINIO_ENDPOINT=minio
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=crm-lineoa
# MINIO_PUBLIC_URL=http://YOUR_EC2_PUBLIC_IP:9000
#
# Optional host port mappings
# API_HOST_PORT=3000
# MINIO_HOST_PORT=9000
