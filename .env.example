# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (local docker-compose)
DATABASE_URL=postgresql://user:password@localhost:5432/crm_lineoa_db

# Database Sandbox (AWS RDS) — uncomment & fill when running migrate against RDS
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d

# LINE BOT
LINE_BOT_CHANNEL_ACCESS_TOKEN=your_line_bot_token_here
LINE_BOT_CHANNEL_SECRET=your_line_bot_secret_here

# Member login OTP (demo)
OTP_CODE=123456
OTP_TTL_SECONDS=60

# Frontend / LIFF origins (CORS)
# Must match the browser Origin exactly (scheme + host, no path / trailing slash)
# FRONTEND_URL=https://crm-web.vortex-dev.com
# Optional extra origins (comma-separated)
# CORS_ORIGINS=https://main.d2t43thpr4t9mh.amplifyapp.com
# LIFF_ENDPOINT_URL=https://crm-web.vortex-dev.com/liff/login

# AMQP (RabbitMQ)
AMQP_URL=amqp://guest:guest@localhost:5672

# Object storage — local MinIO (S3-compatible)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=crm-oa-storage
S3_PUBLIC_URL=http://localhost:9000/crm-oa-storage
S3_AUTO_CREATE_BUCKET=true

# Logging
LOG_LEVEL=debug
# Write JSON access logs for Grafana Loki (local observability)
OBS_LOG_DIR=./logs
# Push logs directly to Loki (recommended on Mac)
OBS_LOKI_URL=http://localhost:3100

# Observability (local)
# WORKER_METRICS_PORT=9465

# ── GCP / docker-compose.prod.yml ───────────────────────────────────────────
# Production .env is rendered by scripts/deploy/render-env.sh from GitHub secrets.
# Required secrets: DATABASE_URL (Neon unpooled), JWT_SECRET, LINE_BOT_*, S3 HMAC
# Optional vars: S3_BUCKET, S3_PUBLIC_URL, S3_REGION, S3_ENDPOINT
#
# NODE_ENV=production
# LOG_LEVEL=info
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
#
# RabbitMQ (internal compose network — must match RABBITMQ_* below)
# AMQP_URL=amqp://crm:changeme@rabbitmq:5672
# RABBITMQ_USER=crm
# RABBITMQ_PASS=changeme
#
# GCS via S3 XML API (prod)
# S3_ENDPOINT=storage.googleapis.com
# S3_PORT=443
# S3_USE_SSL=true
# S3_REGION=us-central1
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_BUCKET=your-gcs-bucket
# S3_PUBLIC_URL=https://storage.googleapis.com/your-gcs-bucket
# S3_AUTO_CREATE_BUCKET=false
#
# Host port 80 for Cloudflare Flexible SSL
# API_HOST_PORT=80
